{
  // Cloudflare Workers config. The store's pages are rendered by the Worker from store.json,
  // products.json and the band's live edits; images, the stylesheet and the script are static
  // files in ./dist. Nothing in this file needs changing to deploy your own store.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "merch-table",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/products/*", "/cart", "/cart/", "/thanks", "/thanks/", "/shipping", "/shipping/", "/site.css", "/img/*", "/merch.json", "/feed.xml", "/sitemap.xml", "/robots.txt", "/api/*", "/admin", "/admin/*", "/orders", "/orders/*", "/tickets", "/tickets/*"]
  },
  "observability": { "enabled": true },
  // Where the admin's edits, orders, ticket check-ins and stock counts live. No id on purpose:
  // the Deploy button and `wrangler deploy` both create a namespace for you and bind it here,
  // and later deploys reuse the one already bound to the Worker.
  "kv_namespaces": [{ "binding": "STOCK" }],
  // Optional settings go in Cloudflare → your store → Settings → Variables and Secrets, not here:
  //   SITE_URL   only if fans reach the store at an address other than the one it answers on
  //   OWNER_EMAIL, ADMIN_KEY, STRIPE_SECRET_KEY, RESEND_API_KEY, MAIL_FROM   (see .dev.vars.example)
  // The public demo at merch-table-demo.isaac-holze.workers.dev. Not for your store.
  "env": {
    "demo": {
      "name": "merch-table-demo",
      "kv_namespaces": [{ "binding": "STOCK", "id": "bf5034b2c9744d2fa6088ca60fa8197d" }],
      "vars": {
        "SITE_URL": "https://merch-table-demo.isaac-holze.workers.dev",
        // Lets anyone look around the admin without signing in. Saves are refused.
        // NEVER set this on a real store — it shows your product list and orders screen to everyone.
        "DEMO_ADMIN": "1"
      }
    }
  }
}
